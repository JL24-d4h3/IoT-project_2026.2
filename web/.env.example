# Copiar a .env y completar los valores requeridos. No publicar el archivo real.
# Formato de propiedades Java: CLAVE=valor, sin comillas de shell.
DB_URL=
DB_USER=
DB_PASSWORD=
ADMIN_PASSWORD=
JWT_SECRET=

DB_DDL_AUTO=none
SPRING_PROFILES_ACTIVE=prod
APP_ALMACENAMIENTO=local
APP_URL_BASE=http://localhost:8080

# Solo si APP_ALMACENAMIENTO=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: administracion REST desde el superadministrador de Android.
FIREBASE_PROJECT_ID=
FIREBASE_SUPERADMIN_UIDS=
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional: requiere perfil demo, sin prod, y una base vacia.
DEMO_TAXISTA_PASSWORD=
