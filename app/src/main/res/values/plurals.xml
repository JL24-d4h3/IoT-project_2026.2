<?xml version="1.0" encoding="utf-8"?>
<!--
    Plurales. El codigo de la aplicacion compone casi todos sus textos en Java
    porque salen de los modelos, pero aqui el numero viene de un dato y la
    concordancia es responsabilidad de la interfaz: "1 servicios" es un error
    que se ve, y una cadena de formato no lo puede resolver.
-->
<resources>

    <plurals name="taxi_servicios_conductor">
        <item quantity="one">%1$d servicio</item>
        <item quantity="other">%1$d servicios</item>
    </plurals>

    <plurals name="taxi_resenas_conductor">
        <item quantity="one">%1$d calificación</item>
        <item quantity="other">%1$d calificaciones</item>
    </plurals>

