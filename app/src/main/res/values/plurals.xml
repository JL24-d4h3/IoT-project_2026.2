        <item quantity="other">%1$d alojamientos</item>
    </plurals>

    <plurals name="destino_total">
        <item quantity="one">%1$d alojamiento</item>
        <item quantity="other">%1$d alojamientos</item>
    </plurals>

    <plurals name="perfil_tarjetas">
