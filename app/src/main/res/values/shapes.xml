<?xml version="1.0" encoding="utf-8"?>
<!--
    Familia de radios (CONTEXTO_FRONTEND.md §6.4).

    Una sola familia coherente: prohibido mezclar cards muy redondeadas con
    cuadradas, o botones circulares con inputs rectos (§9). Estos shape
    appearances se enlazan a los roles de Material 3 en themes.xml, de modo que
    los widgets que no estilice explicitamente tambien caigan en la escala.
-->
<resources>

    <style name="ShapeAppearance.App.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_chip</item>
    </style>

    <style name="ShapeAppearance.App.Control" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>

    <style name="ShapeAppearance.App.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_card</item>
    </style>

    <!-- Solo esquinas superiores: para la imagen que corona una card -->
    <style name="ShapeAppearance.App.CardTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_card</item>
        <item name="cornerSizeTopRight">@dimen/radius_card</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_sheet</item>
        <item name="cornerSizeTopRight">@dimen/radius_sheet</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
