<?xml version="1.0" encoding="utf-8"?>
<!-- Huespedes (§16). Hoja inferior y no pantalla: son tres numeros y se
     ajustan mirando el resultado, no navegando a otro sitio.

     El resumen se repite abajo aunque los tres controles ya digan sus numeros,
     porque la pregunta que el usuario se hace no es "cuantos adultos" sino
     "que he elegido en total". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/sheet_top_padding"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_xl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.App.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_huespedes" />

        <ImageButton
            android:id="@+id/hoja_cerrar"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_cerrar"
            android:padding="@dimen/space_md"
            android:src="@drawable/ic_close"
            app:tint="@color/colorTextPrimary" />
    </LinearLayout>

    <org.iot.project.ui.components.GuestSelectorView
        android:id="@+id/selector_huespedes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm" />

    <View
        style="@style/Widget.App.Divider"
        android:layout_marginTop="@dimen/space_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:orientation="vertical">

        <TextView
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/huespedes_resumen_etiqueta" />

        <TextView
            android:id="@+id/hoja_resumen"
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="2 adultos · 1 habitación" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/hoja_aplicar"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/accion_aplicar" />

</LinearLayout>
