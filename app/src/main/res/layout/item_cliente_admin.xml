<?xml version="1.0" encoding="utf-8"?>
<!--
    Un cliente del hotel en la lista del administrador (§44).

    La tarjeta no es tocable y no lleva chevron: no hay ficha de cliente a la
    que ir. Un chevron que no lleva a ningún sitio, o una tarjeta que se hunde al
    tocarla y no hace nada, enseña a desconfiar de las demás tarjetas de la
    aplicación.

    El distintivo de "alojado ahora" solo aparece cuando lo está. Es el único
    dato vivo de la fila —lo demás es historial— y es el que hace que valga la
    pena mirar la lista antes de responder en recepción.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cliente_nombre"
                style="@style/TextAppearance.App.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Lucía Quispe Ramos" />

            <TextView
                android:id="@+id/cliente_estado"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_badge_primary"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/admin_clientes_alojado"
                android:textColor="@color/colorOnPrimaryContainer"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/cliente_contacto"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="DNI 40918273 · lucia.quispe@correo.com" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_thickness"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/colorDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cliente_estancias"
                style="@style/TextAppearance.App.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="3 estadías · última el 20 set" />

            <TextView
                android:id="@+id/cliente_total"
                style="@style/TextAppearance.App.Price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="S/ 3,840" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
