<?xml version="1.0" encoding="utf-8"?>
<!--
    Busqueda y resultados (§13 a §19).

    La pantalla tiene dos caras y las mantiene montadas a la vez: el formulario
    de §13 y la lista de §17. No es un descuido —volver a inflar el formulario
    cada vez que el usuario pulsa "editar" perderia lo que tenia escrito—, sino
    que se enciende una y se apaga la otra. Quien decide cual es SearchViewModel,
    no este archivo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_lg">

        <TextView
            style="@style/TextAppearance.App.H1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_buscar" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============================================================
             CARA A: el formulario de busqueda (§13)
             ============================================================ -->
        <ScrollView
            android:id="@+id/form_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/buscar_subtitulo" />

                <!-- Las tres decisiones de la busqueda viven en una sola tarjeta
                     partida por divisores: son un formulario, y separarlas en
                     tres tarjetas las haria parecer tres cosas sin relacion. -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Destino: lleva a su propia pantalla (§14) porque
                             necesita lista, historial y busqueda por texto. -->
                        <LinearLayout
                            android:id="@+id/row_destino"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/form_row_height"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/screen_margin"
                            android:paddingEnd="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_location"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/buscar_destino_etiqueta" />

                                <TextView
                                    android:id="@+id/valor_destino"
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/buscar_destino_pista"
                                    android:textColor="@color/colorTextSecondary" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/colorTextSecondary" />
                        </LinearLayout>

                        <View
                            style="@style/Widget.App.Divider"
                            android:layout_marginStart="@dimen/screen_margin" />

                        <!-- Fechas: entrada y salida en la misma fila porque
                             son una sola decision —el rango—, y elegirlas por
                             separado obligaria a dos viajes a la hoja. -->
                        <LinearLayout
                            android:id="@+id/row_fechas"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/form_row_height"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/screen_margin"
                            android:paddingEnd="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/buscar_entrada" />

                                <TextView
                                    android:id="@+id/valor_entrada"
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="@string/buscar_fechas_pista"
                                    android:textColor="@color/colorTextSecondary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/buscar_salida" />

                                <TextView
                                    android:id="@+id/valor_salida"
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    tools:text="22 set" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/colorTextSecondary" />
                        </LinearLayout>

                        <View
                            style="@style/Widget.App.Divider"
                            android:layout_marginStart="@dimen/screen_margin" />

                        <LinearLayout
                            android:id="@+id/row_huespedes"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/form_row_height"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/screen_margin"
                            android:paddingEnd="@dimen/space_md">

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_person_group"
                                app:tint="@color/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/buscar_huespedes_etiqueta" />

                                <TextView
                                    android:id="@+id/valor_huespedes"
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    tools:text="2 adultos · 1 habitación" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/colorTextSecondary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dice qué falta para poder buscar. El botón deshabilitado
                     solo no lo explica: un botón apagado sin motivo se lee
                     como una aplicación rota (§53). -->
                <TextView
                    android:id="@+id/form_hint"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    tools:text="Elige tus fechas para continuar" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_buscar"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/buscar_boton" />
            </LinearLayout>
        </ScrollView>

        <!-- ============================================================
             CARA B: los resultados (§17)
             ============================================================ -->
        <LinearLayout
            android:id="@+id/results_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Barra de resumen. Se toca para volver al formulario: es lo que
                 el usuario acaba de decidir, y editarlo no debería exigir
                 buscar un botón aparte. -->
            <LinearLayout
                android:id="@+id/resumen_barra"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_md"
                android:layout_marginEnd="@dimen/screen_margin"
                android:background="@drawable/bg_search_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    android:id="@+id/resumen_texto"
                    style="@style/TextAppearance.App.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Cusco · 20 set – 22 set · 2 adultos" />

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@string/resultados_editar"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/colorTextSecondary" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/screen_margin"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btn_filtros"
                        style="@style/Widget.App.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resultados_filtros"
                        app:chipIcon="@drawable/ic_filter" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/btn_orden"
                        style="@style/Widget.App.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        app:chipIcon="@drawable/ic_sort"
                        tools:text="Ordenar · Precio menor" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/results_count"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/screen_margin"
                tools:text="24 alojamientos en Cusco" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_results"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_md"
                    android:visibility="gone"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_hotel_card"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/skeleton_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/screen_margin"
                    android:paddingEnd="@dimen/screen_margin"
                    android:visibility="gone" />

                <org.iot.project.ui.components.EmptyStateView
                    android:id="@+id/state_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <org.iot.project.ui.components.ErrorStateView
                    android:id="@+id/state_error"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_mas"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/screen_margin"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/screen_margin"
                android:layout_marginBottom="@dimen/space_md"
                android:text="@string/resultados_ver_mas"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
