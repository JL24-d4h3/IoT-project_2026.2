<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <TextView
            android:id="@+id/sa_conductor_nombre"
            style="@style/TextAppearance.App.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Pedro Ccahuana Loayza" />

        <TextView
            android:id="@+id/sa_conductor_contacto"
            style="@style/TextAppearance.App.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="p.ccahuana@taxi.pe · +51 966 887 221" />

        <TextView
            android:id="@+id/sa_conductor_documento"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone"
            tools:text="DNI · ****1234"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/sa_conductor_vehiculo"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            tools:text="Kia Rio · Azul · X3Y-204" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sa_conductor_insignia_estado"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                tools:text="Aprobado" />

            <TextView
                android:id="@+id/sa_conductor_insignia_cuenta"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                tools:text="Cuenta activa" />
        </LinearLayout>

        <TextView
            android:id="@+id/sa_conductor_nota"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sa_conductor_accion"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:minHeight="@dimen/button_height"
            tools:text="Aprobar para trabajar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sa_conductor_cuenta_accion"
            style="@style/Widget.App.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:minHeight="@dimen/button_height"
            tools:text="Desactivar cuenta web" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
