<?xml version="1.0" encoding="utf-8"?>
<!--
    Un conductor en la lista del superadministrador (RF-077, RF-078).

    Misma fila que la de cuentas —nombre, dato de contacto, insignia y acción—
    para que las dos listas del panel se lean igual. Lo propio del conductor es
    el vehículo: es lo que se mira antes de aprobarlo, y sin él no puede
    prestar el servicio, así que va en la misma línea que el estado.

    El botón dice la acción y no el estado: "Habilitar" sobre un conductor
    pendiente, "Retirar" sobre uno habilitado.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_base"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sa_conductor_nombre"
                style="@style/TextAppearance.App.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Pedro Ccahuana Loayza" />

            <TextView
                android:id="@+id/sa_conductor_contacto"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="p.ccahuana@taxi.pe · +51 966 887 221" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sa_conductor_insignia_estado"
                    style="@style/TextAppearance.App.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_xs"
                    tools:background="@drawable/bg_badge_warning"
                    tools:text="Pendiente" />

                <TextView
                    android:id="@+id/sa_conductor_vehiculo"
                    style="@style/TextAppearance.App.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    tools:text="Kia Rio · Azul · X3Y-204" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sa_conductor_accion"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            tools:text="Habilitar" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
