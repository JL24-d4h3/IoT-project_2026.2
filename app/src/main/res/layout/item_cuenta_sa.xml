<?xml version="1.0" encoding="utf-8"?>
<!--
    Una cuenta en la lista del superadministrador (RF-005, RF-006).

    El botón dice la acción, no el estado: "Desactivar" sobre una cuenta activa.
    Se usa un botón y no un interruptor porque desactivar deja a alguien fuera
    de la aplicación (RF-009) y tiene que preguntarse antes; un interruptor que
    se enciende y hay que revertir cuando el usuario cancela miente un instante.

    Sin círculo de iniciales: la fila enseña quien es —nombre, correo, rol y si
    puede entrar— y las iniciales no añaden nada a eso. Sería además un hueco
    que nunca se llena con una fotografía, porque esta lista no las pide.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_base"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/space_base"
        android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sa_cuenta_nombre"
                style="@style/TextAppearance.App.H3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Lucía Quispe Ramos" />

            <TextView
                android:id="@+id/sa_cuenta_email"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="lucia.quispe@correo.pe" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                app:chipSpacingHorizontal="@dimen/space_sm"
                app:chipSpacingVertical="@dimen/space_sm">

                <TextView
                    android:id="@+id/sa_cuenta_rol"
                    style="@style/TextAppearance.App.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_primary"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_xs"
                    android:textColor="@color/colorOnPrimaryContainer"
                    tools:text="Administrador de hotel" />

                <TextView
                    android:id="@+id/sa_cuenta_estado"
                    style="@style/TextAppearance.App.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingTop="@dimen/space_xs"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_xs"
                    tools:background="@drawable/bg_badge_success"
                    tools:text="Activa" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sa_cuenta_accion"
            style="@style/Widget.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_sm"
            tools:text="Desactivar" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
