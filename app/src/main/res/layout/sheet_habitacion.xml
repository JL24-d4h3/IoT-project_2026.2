<?xml version="1.0" encoding="utf-8"?>
<!--
    Registrar o editar una habitación (§42, RF-014 a RF-018).

    El tipo se escribe y no se elige de una lista cerrada a propósito: el
    catálogo de habitaciones del hotel tiene nombres como "Doble clásica" o
    "Superior ejecutiva", y el tipo de la habitación es ese nombre (RF-015). La
    taxonomía de la búsqueda (individual, doble, triple, suite) se deduce de él,
    así que encerrarlo en cuatro opciones obligaría a renombrar habitaciones que
    ya existen.

    Los campos cortos van de dos en dos —adultos con niños, área con piso— para
    que la hoja no obligue a desplazarse: cada pareja cabe en un renglón.

    El desplazamiento envuelve la hoja entera, título y botones incluidos, que es
    como están hechas las demás hojas de la aplicación: con el teclado abierto,
    lo que tiene que poder alcanzarse es el botón de guardar.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/sheet_top_padding"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/habitacion_titulo"
                style="@style/TextAppearance.App.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Nueva habitación" />

            <ImageButton
                android:id="@+id/habitacion_cerrar"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cerrar"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_close"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/habitacion_numero_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_habitacion_numero">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/habitacion_numero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="20"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/habitacion_tipo_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_habitacion_tipo"
                app:helperText="@string/admin_habitacion_tipo_ayuda">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/habitacion_tipo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ============ Capacidad ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/habitacion_adultos_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/admin_habitacion_adultos">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/habitacion_adultos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/habitacion_ninos_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/admin_habitacion_ninos">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/habitacion_ninos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="2"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ============ Superficie y ubicación ============ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/habitacion_area_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/admin_habitacion_area"
                    app:suffixText="@string/admin_habitacion_area_sufijo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/habitacion_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLength="6"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/habitacion_piso_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/admin_habitacion_piso">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/habitacion_piso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLength="3"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/habitacion_precio_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_habitacion_precio"
                app:prefixText="@string/admin_servicio_moneda">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/habitacion_precio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:maxLength="8"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/habitacion_guardar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/accion_guardar" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
