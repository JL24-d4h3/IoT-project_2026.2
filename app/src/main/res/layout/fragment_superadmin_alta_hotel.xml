<?xml version="1.0" encoding="utf-8"?>
<!--
    Registrar un hotel (RF-007).

    Un alta la pide el dueño del hotel por fuera de la aplicación —llama a la
    plataforma y dice que quiere ofrecer su alojamiento— y la ejecuta el
    superadministrador, que es quien responde por lo que hay dentro del catálogo.

    Se piden solo los datos con los que se puede abrir la ficha. Las fotografías,
    las habitaciones y los servicios necesitan a alguien que conozca el hotel, y
    ese es su administrador: pedirlos aquí sería inventárselos.

    Los dos campos de coordenadas van juntos porque se copian juntos de un mapa,
    y sin ellas el hotel no se puede situar en el plano del traslado (RF-084).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/sa_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sa_alta_contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg">

            <!-- ============ Lo que el hotel es ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        style="@style/TextAppearance.App.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sa_alta_datos" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/sa_alta_nombre_campo"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:hint="@string/sa_alta_nombre">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/sa_alta_nombre"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="60"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/sa_alta_ciudad_campo"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:hint="@string/sa_alta_ciudad">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/sa_alta_ciudad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="40"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/sa_alta_distrito_campo"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:hint="@string/sa_alta_distrito">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/sa_alta_distrito"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapWords"
                            android:maxLength="40"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/sa_alta_direccion_campo"
                        style="@style/Widget.App.TextInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:hint="@string/sa_alta_direccion">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/sa_alta_direccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLength="80"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ Dónde cae en el mapa ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        style="@style/TextAppearance.App.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sa_alta_ubicacion" />

                    <TextView
                        style="@style/TextAppearance.App.BodySecondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/sa_alta_ayuda_coordenadas" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sa_alta_latitud_campo"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/sa_alta_latitud">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sa_alta_latitud"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/sa_alta_longitud_campo"
                            style="@style/Widget.App.TextInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:hint="@string/sa_alta_longitud">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/sa_alta_longitud"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal|numberSigned"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sa_alta_guardar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_base"
                android:text="@string/sa_alta_guardar" />

            <!--
                El aviso va debajo del botón y no en un diálogo: es lo que
                explica por qué el hotel recién registrado no aparece en el
                buscador del cliente, y sin él el alta parece no haber hecho
                nada.
            -->
            <TextView
                android:id="@+id/sa_alta_aviso"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/sa_alta_aviso"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
