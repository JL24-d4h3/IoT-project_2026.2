<?xml version="1.0" encoding="utf-8"?>
<!--
    Portada del conductor (§46).

    Una sola pantalla con dos caras que se excluyen. §46 lo pide literal: con un
    servicio activo hay que ocultar la lista de solicitudes y concentrar toda la
    pantalla en el servicio actual. Por eso son dos bloques separados y no una
    lista con un detalle encima: en cada momento se ve uno, nunca los dos.

    Las dos caras van dentro de un NestedScrollView, como el resto de pantallas
    largas del proyecto. La lista de solicitudes lleva nestedScrollingEnabled en
    falso para que el gesto pertenezca al scroll de fuera y no se quede atrapado
    en la primera tarjeta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/driver_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ==================== Cara libre: el conductor no tiene viaje ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/driver_libre"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <!--
                    Las tres cifras de su jornada. Van juntas y con divisores
                    porque se leen como un conjunto, no una por una.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingTop="@dimen/space_md"
                        android:paddingBottom="@dimen/space_md">

                        <org.iot.project.ui.components.StatView
                            android:id="@+id/driver_metrica_disponibles"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/divider_thickness"
                            android:layout_height="@dimen/space_3xl"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_md"
                            android:background="@color/colorDivider" />

                        <org.iot.project.ui.components.StatView
                            android:id="@+id/driver_metrica_activos"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <View
                            android:layout_width="@dimen/divider_thickness"
                            android:layout_height="@dimen/space_3xl"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_marginEnd="@dimen/space_md"
                            android:background="@color/colorDivider" />

                        <org.iot.project.ui.components.StatView
                            android:id="@+id/driver_metrica_completados"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                    Su ficha y su vehiculo en una sola tarjeta: DriverCardView ya
                    lleva dentro un VehicleCardView, y ponerlos por separado
                    enseñaba el mismo auto dos veces seguidas.
                -->
                <org.iot.project.ui.components.DriverCardView
                    android:id="@+id/driver_conductor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base" />

                <TextView
                    style="@style/TextAppearance.App.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:text="@string/driver_home_disponibles"
                    android:textColor="@color/colorTextSecondary" />

                <!--
                    RF-088, RF-089. Cada tarjeta ya trae su distancia calculada
                    por el repositorio: aqui no se calcula nada.
                -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/driver_solicitudes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_solicitud_taxi"
                    tools:visibility="visible" />

                <!-- RF-088: sin solicitudes cerca, se dice; no se deja en blanco. -->
                <org.iot.project.ui.components.EmptyStateView
                    android:id="@+id/driver_vacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ==================== Cara ocupada: hay un servicio en curso ==================== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/driver_ocupado"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    style="@style/TextAppearance.App.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_servicio_activo"
                    android:textColor="@color/colorTextSecondary" />

                <!-- RF-106: la linea de estados, para saber en que punto va. -->
                <org.iot.project.ui.components.TaxiStatusView
                    android:id="@+id/driver_estado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/driver_fila_recogida"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/driver_fila_destino"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/driver_fila_pasajeros"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!--
                    §7.1: una sola accion primaria por pantalla. Su texto y su
                    destino cambian con el estado, pero en ningun momento hay dos
                    botones compitiendo: a FINALIZADO no se llega desde aqui, se
                    llega validando el codigo (RF-110).
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driver_accion"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_lg"
                    tools:text="Voy en camino" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/driver_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/driver_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
