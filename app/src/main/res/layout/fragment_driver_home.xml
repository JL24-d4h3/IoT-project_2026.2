<?xml version="1.0" encoding="utf-8"?>
<!--
    Portada del taxista: su servicio en curso o las solicitudes que puede
    aceptar. Los datos vienen de la API del sistema de taxistas.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/driver_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/driver_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <!-- Quien es el taxista -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- La foto y el círculo de iniciales ocupan el mismo hueco:
                                 si la foto carga se ve encima; si no, quedan las iniciales. -->
                            <FrameLayout
                                android:layout_width="@dimen/avatar_lg"
                                android:layout_height="@dimen/avatar_lg">

                                <TextView
                                    android:id="@+id/driver_iniciales"
                                    style="@style/TextAppearance.App.H2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_circulo_primario"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:textColor="@color/colorOnPrimaryContainer"
                                    tools:text="JP" />

                                <ImageView
                                    android:id="@+id/driver_foto"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/cd_foto_conductor"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_base"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/driver_nombre"
                                    style="@style/TextAppearance.App.H3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:text="Juan Pérez" />

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:text="@string/driver_auth_rol" />

                                <TextView
                                    android:id="@+id/driver_placa"
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:visibility="gone"
                                    tools:text="Placa ABC-123"
                                    tools:visibility="visible" />
                            </LinearLayout>
                        </LinearLayout>

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/driver_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Servicio en curso: reemplaza a la lista de solicitudes -->
                <LinearLayout
                    android:id="@+id/driver_activo_seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        style="@style/TextAppearance.App.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/driver_servicio_activo" />

                    <org.iot.project.ui.components.TaxiRequestCardView
                        android:id="@+id/driver_activo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/driver_avanzar"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:minHeight="@dimen/button_height"
                        android:text="@string/driver_voy_en_camino"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/driver_validar"
                        style="@style/Widget.App.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:minHeight="@dimen/button_height"
                        android:text="@string/driver_validar_codigo"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Solicitudes disponibles: solo cuando no hay servicio en curso -->
                <LinearLayout
                    android:id="@+id/driver_ofertas_seccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.App.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/driver_home_disponibles" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/driver_solicitudes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/driver_vacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/driver_sin_servicio_titulo" />

                        <TextView
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/driver_sin_servicio" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/driver_cargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/driver_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/driver_acciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/driver_cerrar_sesion"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/sesion_cerrar"
            app:icon="@drawable/ic_logout" />
    </LinearLayout>
</LinearLayout>
