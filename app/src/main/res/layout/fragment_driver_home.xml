<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/driver_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/driver_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <TextView
                    style="@style/TextAppearance.App.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/driver_auth_bienvenida" />

                <TextView
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/driver_auth_acceso_listo" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="@dimen/avatar_lg"
                                android:layout_height="@dimen/avatar_lg">

                                <TextView
                                    android:id="@+id/driver_iniciales"
                                    style="@style/TextAppearance.App.H2"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_circulo_primario"
                                    android:gravity="center"
                                    android:importantForAccessibility="no"
                                    android:textColor="@color/colorOnPrimaryContainer"
                                    tools:text="JP" />

                                <ImageView
                                    android:id="@+id/driver_foto"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:importantForAccessibility="no"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_base"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/driver_nombre"
                                    style="@style/TextAppearance.App.H3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    tools:text="Juan Pérez" />

                                <TextView
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    android:text="@string/driver_auth_rol" />
                            </LinearLayout>
                        </LinearLayout>

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/driver_correo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg" />

                        <TextView
                            android:id="@+id/driver_vehiculo"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <TextView
                            android:id="@+id/driver_perfil_aviso"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:accessibilityLiveRegion="polite"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/driver_panel_servicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driver_actualizar_ubicacion"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:text="@string/api_driver_ubicacion_actualizar" />

                <TextView
                    android:id="@+id/driver_ubicacion_estado"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/api_driver_ubicacion_ayuda" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driver_ubicacion_ajustes"
                    style="@style/Widget.App.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:minHeight="48dp"
                    android:text="@string/api_driver_ubicacion_ajustes"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/driver_seguimiento_estado"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/driver_refrescar"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:text="@string/api_driver_actualizar" />

                <TextView
                    style="@style/TextAppearance.App.H3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/driver_servicio_activo" />

                <TextView
                    android:id="@+id/driver_activos_aviso"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/api_driver_cargando" />

                <LinearLayout
                    android:id="@+id/driver_servicios_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/TextAppearance.App.H3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/driver_home_disponibles" />

                <TextView
                    android:id="@+id/driver_ofertas_aviso"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/api_driver_cargando" />

                <LinearLayout
                    android:id="@+id/driver_ofertas_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/driver_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/driver_acciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_sm">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/driver_cerrar_sesion"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="@string/sesion_cerrar"
            app:icon="@drawable/ic_logout" />
    </LinearLayout>
</LinearLayout>
