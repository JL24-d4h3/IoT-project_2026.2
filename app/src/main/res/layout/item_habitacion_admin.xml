<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de habitación en el panel del administrador (§42, RF-014 a RF-018).

    No reutiliza la tarjeta de habitación del cliente: aquella enseña una foto
    grande porque sirve para elegir, y aquí se viene a gestionar. §42 pide "más
    densidad informativa, menos fotografía", y con veinte habitaciones una
    lista de tarjetas con foto obliga a desplazarse para encontrar la que se
    busca.

    El interruptor de disponibilidad vive en la fila y no dentro de una ficha:
    retirar una habitación de la venta es la operación diaria —una avería, una
    reforma— y esconderla detrás de dos toques la convertiría en una tarea.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habitacion_numero"
                style="@style/TextAppearance.App.H3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="601" />

            <TextView
                android:id="@+id/habitacion_tipo"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Suite" />

            <TextView
                android:id="@+id/habitacion_retirada"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_error"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/admin_habitacion_retirada"
                android:textColor="@color/colorOnErrorContainer"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/habitacion_capacidad"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="2 adultos · 1 niño · 32 m² · piso 6" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_thickness"
            android:layout_marginTop="@dimen/space_md"
            android:background="@color/colorDivider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/habitacion_precio"
                style="@style/TextAppearance.App.Price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="S/ 320" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/habitacion_disponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target_min"
                android:text="@string/admin_habitacion_a_la_venta"
                android:textAppearance="@style/TextAppearance.App.Caption"
                tools:checked="true" />

            <ImageButton
                android:id="@+id/habitacion_editar"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginStart="@dimen/space_sm"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_editar_habitacion"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_edit"
                app:tint="@color/colorTextSecondary" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
