<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/reserva_formulario"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <!-- Qué se está reservando -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/reserva_foto"
                                android:layout_width="@dimen/thumbnail_md"
                                android:layout_height="@dimen/thumbnail_md"
                                android:contentDescription="@string/cd_imagen_habitacion"
                                android:scaleType="centerCrop"
                                tools:src="@tools:sample/backgrounds/scenic" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/space_md">

                                <TextView
                                    android:id="@+id/reserva_hotel"
                                    style="@style/TextAppearance.App.H3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    tools:text="Casa del Mar" />

                                <TextView
                                    android:id="@+id/reserva_habitacion"
                                    style="@style/TextAppearance.App.BodySecondary"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    tools:text="Doble superior · 2 huéspedes" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Fechas -->
                    <TextView
                        style="@style/TextAppearance.App.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/reserva_fechas_titulo" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/reserva_campo_entrada"
                            style="@style/Widget.App.Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_md">

                                <TextView
                                    style="@style/TextAppearance.App.Label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reserva_entrada" />

                                <TextView
                                    android:id="@+id/reserva_entrada"
                                    style="@style/TextAppearance.App.H3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    tools:text="12 oct" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/reserva_campo_salida"
                            style="@style/Widget.App.Card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="@dimen/space_md">

                                <TextView
                                    style="@style/TextAppearance.App.Label"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reserva_salida" />

                                <TextView
                                    android:id="@+id/reserva_salida"
                                    style="@style/TextAppearance.App.H3"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    tools:text="15 oct" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Huéspedes -->
                    <TextView
                        style="@style/TextAppearance.App.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/reserva_huespedes_titulo" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_md"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingEnd="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/reserva_adultos" />

                                <TextView
                                    android:id="@+id/reserva_capacidad"
                                    style="@style/TextAppearance.App.Caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xs"
                                    tools:text="Máximo 2 personas" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/reserva_menos"
                                android:layout_width="@dimen/touch_target_min"
                                android:layout_height="@dimen/touch_target_min"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/cd_quitar_huesped"
                                android:padding="@dimen/space_sm"
                                android:src="@drawable/ic_remove"
                                app:tint="@color/colorPrimary" />

                            <TextView
                                android:id="@+id/reserva_num_huespedes"
                                style="@style/TextAppearance.App.H3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="@dimen/touch_target_min"
                                android:gravity="center"
                                tools:text="2" />

                            <ImageButton
                                android:id="@+id/reserva_mas"
                                android:layout_width="@dimen/touch_target_min"
                                android:layout_height="@dimen/touch_target_min"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/cd_agregar_huesped"
                                android:padding="@dimen/space_sm"
                                android:src="@drawable/ic_add"
                                app:tint="@color/colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Desglose -->
                    <TextView
                        style="@style/TextAppearance.App.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/reserva_desglose_titulo" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <org.iot.project.ui.components.PriceBreakdownView
                                android:id="@+id/reserva_desglose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                style="@style/TextAppearance.App.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                android:text="@string/reserva_total_nota" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/reserva_barra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSurface"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reserva_confirmar"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:text="@string/reserva_confirmar" />
            </LinearLayout>
        </LinearLayout>

        <!-- Confirmación: la misma pantalla cambia de cara, para que el usuario
             no tenga que volver atrás para saber si la reserva se creó. -->
        <LinearLayout
            android:id="@+id/reserva_exito"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/empty_state_icon"
                android:layout_height="@dimen/empty_state_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                app:tint="@color/colorSuccess" />

            <TextView
                android:id="@+id/reserva_exito_titulo"
                style="@style/TextAppearance.App.H1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center"
                android:text="@string/reserva_creada_titulo" />

            <TextView
                android:id="@+id/reserva_exito_mensaje"
                style="@style/TextAppearance.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                tools:text="Reserva EST-2026-0421 · Casa del Mar, del 12 al 15 de octubre." />

            <TextView
                android:id="@+id/reserva_exito_aviso"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/reserva_creada_aviso" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/reserva_ver_lista"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/accion_ver_reservas" />        </LinearLayout>
    </FrameLayout>

</LinearLayout>
