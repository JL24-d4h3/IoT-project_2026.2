<?xml version="1.0" encoding="utf-8"?>
<!--
    Auditoría de la plataforma (RF-118 a RF-120).

    El campo de búsqueda va fuera del contenedor con scroll, pegado bajo la
    cabecera: es el mando de la pantalla y tiene que seguir a la vista mientras
    se recorre la lista, no irse hacia arriba con ella.

    Mismo esqueleto que las otras secciones del panel —contenido, esqueleto y
    error— para que ninguna se distinga por cómo carga.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/sa_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <org.iot.project.ui.components.SearchFieldView
        android:id="@+id/sa_bitacora_busqueda"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/screen_margin" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sa_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/sa_bitacora_filtros"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <org.iot.project.ui.components.FilterChipView
                        android:id="@+id/sa_bitacora_solo_cambios"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sa_bitacora_solo_cambios" />
                </com.google.android.material.chip.ChipGroup>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sa_bitacora_lista"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_bitacora" />

                <org.iot.project.ui.components.EmptyStateView
                    android:id="@+id/sa_bitacora_vacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/sa_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/sa_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
