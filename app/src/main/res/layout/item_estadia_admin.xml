<?xml version="1.0" encoding="utf-8"?>
<!--
    Una estadía en curso en la portada del administrador (§43).

    Lleva el estilo de card interactiva porque abre el detalle de la reserva, el
    mismo que abre la lista de reservas. Cuando no lo había, la fila se dibujaba
    sin respuesta al toque: una card con ripple que no lleva a ninguna parte
    promete algo que no cumple.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.App.Card.Interactive"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/estadia_cliente"
                style="@style/TextAppearance.App.H3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Diego Salas Pinto" />

            <TextView
                android:id="@+id/estadia_hoy"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_badge_warning"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/admin_estadia_sale_hoy"
                android:textColor="@color/colorOnWarningContainer"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_xs"
                android:layout_height="@dimen/icon_xs"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar"
                app:tint="@color/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/estadia_habitacion"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Hab. 601 · 3 huéspedes" />

            <TextView
                android:id="@+id/estadia_fechas"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                tools:text="12 set – 16 set" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
