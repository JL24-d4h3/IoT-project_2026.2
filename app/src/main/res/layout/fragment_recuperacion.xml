<?xml version="1.0" encoding="utf-8"?>
<!--
    Recuperación de contraseña (§74).

    Mismo esquema que el registro: el panel de confirmación tapa al formulario.
    Una vez enviado no queda nada que corregir abajo, y dejar el campo a la
    vista invita a enviarlo otra vez.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_2xl">

            <TextView
                style="@style/TextAppearance.App.H1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recuperar_titulo" />

            <TextView
                style="@style/TextAppearance.App.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/recuperar_mensaje" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/recuperar_correo_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:hint="@string/acceso_correo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recuperar_correo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/recuperar_aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_aviso_error"
                android:orientation="horizontal"
                android:padding="@dimen/space_md"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/icon_sm"
                    android:layout_height="@dimen/icon_sm"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/colorOnErrorContainer" />

                <TextView
                    android:id="@+id/recuperar_aviso_texto"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:layout_weight="1"
                    android:textColor="@color/colorOnErrorContainer"
                    tools:text="Ese correo no parece válido." />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recuperar_enviar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/recuperar_enviar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recuperar_cancelar"
                style="@style/Widget.App.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/recuperar_volver" />
        </LinearLayout>
    </ScrollView>

    <!-- Fondo opaco: este panel tapa al formulario que queda debajo. -->
    <LinearLayout
        android:id="@+id/recuperar_exito"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackground"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="@dimen/empty_state_icon"
            android:layout_height="@dimen/empty_state_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notifications"
            app:tint="@color/colorPrimary" />

        <TextView
            style="@style/TextAppearance.App.H1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center"
            android:text="@string/recuperar_listo_titulo" />

        <TextView
            android:id="@+id/recuperar_exito_mensaje"
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recuperar_exito_volver"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_xl"
            android:text="@string/recuperar_volver" />
    </LinearLayout>

</FrameLayout>
