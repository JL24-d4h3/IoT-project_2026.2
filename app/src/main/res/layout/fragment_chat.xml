<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_mensajes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_base"
            android:scrollbars="none"
            app:stackFromEnd="true"
            tools:listitem="@layout/item_message" />

        <org.iot.project.ui.components.EmptyStateView
            android:id="@+id/chat_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/chat_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <org.iot.project.ui.components.LoadingSkeletonView
            android:id="@+id/chat_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- La barra de escritura se esconde cuando no se puede escribir: si el chat
         esta cerrado (RF-065) o la conversacion no cargo, un campo de texto
         activo prometeria algo que el boton de enviar no va a cumplir. -->
    <LinearLayout
        android:id="@+id/chat_entrada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone"
        tools:visibility="visible">

        <EditText
            android:id="@+id/chat_texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:gravity="center_vertical"
            android:hint="@string/chat_escribe"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="@dimen/touch_target_min"
            android:paddingStart="@dimen/space_md"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_md"
            android:paddingBottom="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.App.Body"
            android:textColorHint="@color/colorTextSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_enviar"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@string/cd_enviar_mensaje"
            android:minWidth="@dimen/touch_target_min"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/icon_sm" />
    </LinearLayout>

</LinearLayout>
