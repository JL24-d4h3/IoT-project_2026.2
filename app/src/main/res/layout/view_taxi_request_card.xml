<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/request_code"
                style="@style/TextAppearance.App.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="TAX-2026-0733" />

            <TextView
                android:id="@+id/request_status"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_primary"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:textColor="@color/colorOnPrimaryContainer"
                tools:text="En camino" />
        </LinearLayout>

        <!-- El recorrido se lee de arriba abajo: origen, luego destino. La
             linea vertical del margen es la que hace que se lea como un
             trayecto y no como dos direcciones sueltas. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="@dimen/timeline_column"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="@dimen/timeline_dot"
                    android:layout_height="@dimen/timeline_dot"
                    android:layout_marginTop="@dimen/space_xs"
                    android:background="@drawable/bg_timeline_dot" />

                <View
                    android:layout_width="@dimen/timeline_line"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@color/colorBorder" />

                <View
                    android:layout_width="@dimen/timeline_dot"
                    android:layout_height="@dimen/timeline_dot"
                    android:layout_marginBottom="@dimen/space_xs"
                    android:background="@drawable/bg_timeline_dot"
                    android:backgroundTint="@color/colorAccent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/request_origin"
                    style="@style/TextAppearance.App.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Av. Malecón Cisneros 1240, Miraflores" />

                <TextView
                    android:id="@+id/request_destination"
                    style="@style/TextAppearance.App.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Aeropuerto Jorge Chávez" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/icon_xs"
                android:layout_height="@dimen/icon_xs"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_calendar"
                app:tint="@color/colorTextSecondary" />

            <TextView
                android:id="@+id/request_schedule"
                style="@style/TextAppearance.App.BodySecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_xs"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="15 set · 09:30 · 2 pasajeros" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/request_price"
                style="@style/TextAppearance.App.NumericEmphasis"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="S/ 45" />

            <TextView
                android:id="@+id/request_free"
                style="@style/TextAppearance.App.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_success"
                android:paddingStart="@dimen/space_sm"
                android:paddingTop="@dimen/space_xs"
                android:paddingEnd="@dimen/space_sm"
                android:paddingBottom="@dimen/space_xs"
                android:text="@string/taxi_gratuito"
                android:textColor="@color/colorOnSuccessContainer"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- RF-089. Solo la trae la solicitud vista por el conductor: en el
             historial del cliente no hay ninguna distancia que enseñar. -->
        <TextView
            android:id="@+id/request_distance"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="A 1,9 km de ti" />

        <!-- RF-090. Nace oculto y lo enciende setOnAceptar: la misma tarjeta
             sirve para el historial del cliente, donde no hay nada que aceptar. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_accept"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/driver_aceptar"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- RF-105. Un traslado terminado se puede valorar una sola vez: por eso
             el boton y la nota ya puesta se excluyen, y la nota no es un adorno
             —sin ella el cliente no sabria por que ya no puede calificar. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_rate"
            style="@style/Widget.App.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_sm"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/accion_valorar_taxi"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/request_rated"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:drawablePadding="@dimen/space_xs"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_star"
            app:drawableTint="@color/colorAccent"
            tools:text="Valoraste este traslado con 9"
            tools:visibility="visible" />
    </LinearLayout>

</merge>
