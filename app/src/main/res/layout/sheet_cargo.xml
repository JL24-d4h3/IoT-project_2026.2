<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja para registrar un cobro adicional sobre una estadía (RF-051, RF-052).

    Los tres campos son obligatorios y ninguno lleva valor por defecto: un
    cobro sin motivo o sin observación no se puede explicar después al
    huésped, y RF-052 los exige los tres. El monto va primero porque es lo que
    el administrador tiene delante cuando abre la hoja.

    La raíz es un NestedScrollView con wrap_content, igual que el resto de las
    hojas de la aplicación: los botones van dentro del contenido y no anclados
    abajo, para que con el teclado abierto se puedan alcanzar desplazándose en
    vez de quedar tapados.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/sheet_top_padding"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cargo_titulo"
                style="@style/TextAppearance.App.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cargo_titulo" />

            <ImageButton
                android:id="@+id/cargo_cerrar"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/accion_cerrar"
                android:src="@drawable/ic_close"
                app:tint="@color/colorTextSecondary" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/cargo_monto_campo"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_base"
            android:hint="@string/cargo_monto"
            app:prefixText="@string/admin_servicio_moneda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cargo_monto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:imeOptions="actionNext"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/cargo_motivo_campo"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/cargo_motivo"
            app:helperText="@string/cargo_motivo_ayuda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cargo_motivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/cargo_observacion_campo"
            style="@style/Widget.App.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:hint="@string/cargo_observacion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cargo_observacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="3"
                android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cargo_guardar"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/cargo_guardar" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
