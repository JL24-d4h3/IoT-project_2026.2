<?xml version="1.0" encoding="utf-8"?>
<!--
    Habitaciones del hotel (§42, RF-014 a RF-018).

    Lista densa y no tarjetas con foto: §42 pide "mas densidad informativa,
    menos fotografia", y con veinte habitaciones una lista de tarjetas grandes
    obliga a desplazarse para encontrar la que se busca.

    El recuento va en el subtitulo de la cabecera y no en una fila propia: es un
    dato de contexto —cuantas hay y cuantas estan a la venta— y una fila entera
    para eso gastaria el alto que la lista necesita.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/admin_habitaciones_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/admin_habitaciones_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone"
            tools:itemCount="3"
            tools:listitem="@layout/item_habitacion_admin"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/admin_habitaciones_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.EmptyStateView
            android:id="@+id/admin_habitaciones_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="gone" />

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/admin_habitaciones_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
