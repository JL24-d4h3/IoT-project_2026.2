<?xml version="1.0" encoding="utf-8"?>
<!--
    Clientes del hotel (§44).

    La lista es la respuesta entera, sin tarjeta de encabezado: a diferencia de
    los cobros, aquí no hay una cifra que resuma nada útil. "48 huéspedes" no
    cambia lo que el administrador hace, y ordenar por gasto convertiría el
    directorio en un ranking que nadie pidió.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/admin_clientes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/admin_clientes_lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_md"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_lg"
            android:visibility="gone"
            tools:itemCount="3"
            tools:listitem="@layout/item_cliente_admin"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/admin_clientes_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.EmptyStateView
            android:id="@+id/admin_clientes_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/admin_clientes_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
