<?xml version="1.0" encoding="utf-8"?>
<!--
    Reportes del hotel (§45, RF-055 a RF-061).

    Dos reportes en una pantalla porque son dos preguntas sobre los mismos
    ingresos: cuánto entró en cada periodo, y cuánto de eso lo pusieron los
    servicios adicionales. Separarlos en dos pantallas obligaría a ir y volver
    para poder compararlos.

    El selector de periodo va FUERA del área que cambia de estado, y no es un
    detalle de maquetación: si estuviera dentro, al elegir un periodo sin
    reservas la pantalla quedaría vacía y se llevaría consigo el selector, sin
    forma de volver a un periodo que sí tenga datos. Los botones tienen que
    seguir ahí precisamente cuando la pantalla no tiene nada que enseñar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/admin_reportes_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/admin_reportes_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/screen_margin"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_reportes_diario"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_reportes_diario" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_reportes_mensual"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_reportes_mensual" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/admin_reportes_anual"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/admin_reportes_anual" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/admin_reportes_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <!-- ============ Reservas y ventas (RF-055 a RF-058) ============ -->

                <TextView
                    style="@style/TextAppearance.App.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_reportes_ventas_titulo" />

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:layout_marginBottom="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <TextView
                            android:id="@+id/admin_reportes_ventas"
                            style="@style/TextAppearance.App.PriceLarge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            tools:text="S/ 12,480" />

                        <TextView
                            android:id="@+id/admin_reportes_resumen"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            tools:text="6 reservas · 18 noches" />

                        <!--
                            Deja dicho qué reservas cuentan. Sin esta nota, una
                            reserva pendiente que no aparece en el reporte se
                            leería como un error del sistema.
                        -->
                        <TextView
                            android:id="@+id/admin_reportes_criterio"
                            style="@style/TextAppearance.App.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/admin_reportes_criterio" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/admin_reportes_periodos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_periodo_reporte" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_thickness"
                    android:layout_marginTop="@dimen/space_base"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:background="@color/colorDivider" />

                <!-- ============ Servicios adicionales (RF-060, RF-061) ============ -->

                <TextView
                    style="@style/TextAppearance.App.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_reportes_servicios_titulo" />

                <!--
                    El orden ascendente lo fija RF-061 y es el contrario del que
                    uno esperaría en un ranking. Se avisa para que no se lea
                    como una lista mal ordenada.
                -->
                <TextView
                    android:id="@+id/admin_reportes_servicios_nota"
                    style="@style/TextAppearance.App.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/admin_reportes_servicios_nota" />

                <org.iot.project.ui.components.IngresoListView
                    android:id="@+id/admin_reportes_servicios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm" />

                <TextView
                    android:id="@+id/admin_reportes_servicios_vacio"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/admin_reportes_servicios_vacio"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/admin_reportes_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.EmptyStateView
            android:id="@+id/admin_reportes_vacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/admin_reportes_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
