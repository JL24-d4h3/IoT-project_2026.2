<?xml version="1.0" encoding="utf-8"?>
<!--
    Contenedor raiz: grafo de navegacion arriba, barra inferior abajo.
    Los insets se aplican en codigo (InsetUtils), no con fitsSystemWindows,
    porque cada pantalla decide si su cabecera llega hasta el borde.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/nav_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navGraph="@navigation/nav_auth" />

    <View
        android:id="@+id/nav_divider"
        android:layout_width="0dp"
        android:layout_height="@dimen/divider_thickness"
        android:background="@color/colorDivider"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Sin app:menu a proposito: las secciones son del rol en sesion, no de la
        Activity. MainActivity pone el menu del rol al entrar y lo vacia al
        salir, y mientras tanto la barra no se muestra.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
