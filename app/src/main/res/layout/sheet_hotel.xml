<?xml version="1.0" encoding="utf-8"?>
<!--
    Editar los datos del hotel (§42, RF-010).

    La ubicación va en dos campos y no en un mapa que se arrastra: la
    aplicación no tiene mapas —el del taxi es un esquema— y un mapa de mentira
    del que no se pudieran sacar coordenadas sería peor que dos casillas.

    Latitud y longitud van juntas en un renglón porque son un solo dato dicho
    en dos cifras: separarlas invitaría a rellenar una y olvidar la otra, y el
    error de "indica la ubicación" saldría entonces al guardar, lejos del
    campo que falta.

    Los decimales son negativos en todo el Perú, así que los campos aceptan
    signo; sin él, escribir la latitud de Lima sería imposible.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/sheet_top_padding"
        android:paddingBottom="@dimen/space_lg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <TextView
                android:id="@+id/hotel_titulo"
                style="@style/TextAppearance.App.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/admin_hotel_editar_titulo" />

            <ImageButton
                android:id="@+id/hotel_cerrar"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cerrar"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_close"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hotel_nombre_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_hotel_nombre">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hotel_nombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLength="60"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hotel_descripcion_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_hotel_descripcion"
                app:helperText="@string/admin_hotel_descripcion_ayuda">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hotel_descripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="300"
                    android:maxLines="4"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/hotel_direccion_campo"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:hint="@string/admin_hotel_direccion">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/hotel_direccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="120"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/hotel_latitud_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/admin_hotel_latitud">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hotel_latitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLength="10"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/hotel_longitud_campo"
                    style="@style/Widget.App.TextInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:hint="@string/admin_hotel_longitud">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hotel_longitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLength="10"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hotel_guardar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/accion_guardar" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
