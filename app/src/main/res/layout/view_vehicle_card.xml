<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <ImageView
        android:id="@+id/vehicle_photo"
        android:layout_width="@dimen/thumbnail_sm"
        android:layout_height="@dimen/thumbnail_sm"
        android:background="@drawable/bg_skeleton"
        android:contentDescription="@string/cd_foto_vehiculo"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/vehicle_description"
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Toyota Corolla · Blanco" />

        <!-- La placa es el dato que el cliente busca con la mirada cuando el
             auto llega. Va en su propia linea y en caja alta. -->
        <TextView
            android:id="@+id/vehicle_plate"
            style="@style/TextAppearance.App.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/bg_chip_neutral"
            android:letterSpacing="0.08"
            android:paddingStart="@dimen/space_sm"
            android:paddingTop="@dimen/space_xs"
            android:paddingEnd="@dimen/space_sm"
            android:paddingBottom="@dimen/space_xs"
            tools:text="ABC-123" />
    </LinearLayout>

    <ImageView
        android:id="@+id/vehicle_icon"
        android:layout_width="@dimen/icon_md"
        android:layout_height="@dimen/icon_md"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_taxi"
        app:tint="@color/colorTextSecondary" />

</merge>
