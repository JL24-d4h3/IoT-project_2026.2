<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/space_md"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_md">

    <FrameLayout
        android:layout_width="@dimen/avatar_md"
        android:layout_height="@dimen/avatar_md">

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="@dimen/avatar_md"
            android:layout_height="@dimen/avatar_md"
            android:background="@drawable/bg_chip_neutral"
            android:importantForAccessibility="no"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_notifications"
            app:tint="@color/colorTextSecondary" />

        <View
            android:id="@+id/notification_unread"
            android:layout_width="@dimen/gallery_dot"
            android:layout_height="@dimen/gallery_dot"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_status_dot" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            style="@style/TextAppearance.App.H3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Reserva confirmada" />

        <TextView
            android:id="@+id/notification_message"
            style="@style/TextAppearance.App.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="Tu pago fue aprobado. Te esperamos el 12 de octubre." />

        <TextView
            android:id="@+id/notification_time"
            style="@style/TextAppearance.App.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            tools:text="Hace 2 horas" />
    </LinearLayout>

</LinearLayout>
