<?xml version="1.0" encoding="utf-8"?>
<!-- Valorar un traslado terminado (RF-105).

     Es una hoja y no una pantalla porque la valoracion del taxi tiene un solo
     dato: la nota. Una pantalla entera con una cabecera, un boton de volver y
     una confirmacion aparte daria mas peso a esta accion que a la reserva que
     la origino. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_margin"
    android:paddingTop="@dimen/sheet_top_padding"
    android:paddingEnd="@dimen/screen_margin"
    android:paddingBottom="@dimen/space_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/valorar_taxi_titulo"
            style="@style/TextAppearance.App.H2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/titulo_valorar_taxi" />

        <ImageButton
            android:id="@+id/valorar_taxi_cerrar"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_cerrar"
            android:src="@drawable/ic_close"
            app:tint="@color/colorTextSecondary" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.App.BodySecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/valorar_taxi_mensaje" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.App.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/valorar_taxi_pregunta" />

        <!-- La escala es 1 a 10 y el numero va siempre a la vista: con un
             deslizador suelto no se sabe que valor se esta enviando (§10,
             regla 9). -->
        <org.iot.project.ui.components.RatingBadgeView
            android:id="@+id/valorar_taxi_valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/valorar_taxi_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:stepSize="1"
        android:value="8"
        android:valueFrom="1"
        android:valueTo="10" />

    <TextView
        style="@style/TextAppearance.App.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/valorar_taxi_escala" />

    <TextView
        android:id="@+id/valorar_taxi_error"
        style="@style/TextAppearance.App.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_base"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/colorError"
        android:visibility="gone"
        tools:text="No pudimos guardar tu calificación."
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/valorar_taxi_enviar"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/valorar_enviar" />

</LinearLayout>
