<?xml version="1.0" encoding="utf-8"?>
<!--
    Ficha de un hotel para el superadministrador (RF-008, RF-059).

    Cuatro bloques, y el orden no es casual: primero lo que el hotel es,
    después quién lo lleva, después si se ofrece y al final cómo va. Lo que se
    decide —asignar, publicar— va antes que lo que solo se consulta.

    Los datos y las fotografías se leen y no se tocan: quien los edita es el
    administrador del hotel. Aquí solo se cuenta cuántas hay, porque el mínimo
    de cuatro (RF-013) es lo que decide si el hotel puede publicarse.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/sa_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sa_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_base"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_lg">

                <!-- ============ El hotel ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/sa_ficha_nombre"
                                style="@style/TextAppearance.App.H2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                tools:text="Costa Verde" />

                            <org.iot.project.ui.components.RatingBadgeView
                                android:id="@+id/sa_ficha_rating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/sa_ficha_ubicacion"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            tools:text="Miraflores · Lima" />

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/sa_ficha_fila_direccion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm" />

                        <org.iot.project.ui.components.DataRowView
                            android:id="@+id/sa_ficha_fila_ubicacion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <!--
                            La descripción va en párrafo y no en fila de dato: es
                            texto largo y en la columna derecha de una fila no
                            cabría. El hueco vacío se llena con la frase que dice
                            de quién es la tarea de escribirla, en vez de quedar
                            en blanco, que se leería como un fallo de carga.
                        -->
                        <TextView
                            android:id="@+id/sa_ficha_descripcion"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            tools:text="Habitaciones frente al malecón, a diez minutos del centro." />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/divider_thickness"
                            android:layout_marginTop="@dimen/space_md"
                            android:background="@color/colorDivider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:orientation="horizontal">

                            <org.iot.project.ui.components.StatView
                                android:id="@+id/sa_ficha_fotos"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />

                            <org.iot.project.ui.components.StatView
                                android:id="@+id/sa_ficha_habitaciones"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Quién lo lleva ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <TextView
                            style="@style/TextAppearance.App.H3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sa_hotel_admin" />

                        <TextView
                            android:id="@+id/sa_ficha_admin"
                            style="@style/TextAppearance.App.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            tools:text="Martín Rojas" />

                        <TextView
                            android:id="@+id/sa_ficha_admin_vacio"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/sa_hotel_admin_vacio"
                            android:visibility="gone"
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sa_ficha_asignar"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="@dimen/space_base"
                            tools:text="Asignar administrador" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Si se ofrece ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/TextAppearance.App.H3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/sa_publicacion" />

                            <TextView
                                android:id="@+id/sa_ficha_publicacion_estado"
                                style="@style/TextAppearance.App.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:paddingStart="@dimen/space_sm"
                                android:paddingTop="@dimen/space_xs"
                                android:paddingEnd="@dimen/space_sm"
                                android:paddingBottom="@dimen/space_xs"
                                tools:background="@drawable/bg_badge_success"
                                tools:text="Publicado" />
                        </LinearLayout>

                        <!--
                            Lo que le falta para poder publicarse. Se enseña en
                            lugar de esconder el botón: un botón que desaparece
                            deja al superadministrador sin saber por qué no
                            puede, y esta frase es la misma que necesita el
                            administrador para arreglarlo.
                        -->
                        <TextView
                            android:id="@+id/sa_ficha_publicacion_motivo"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:visibility="gone"
                            tools:text="Para publicarlo faltan fotografías: lleva 2 de 4."
                            tools:visibility="visible" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sa_ficha_publicacion_accion"
                            style="@style/Widget.App.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginTop="@dimen/space_base"
                            tools:text="Retirar del catálogo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ============ Cómo va ============ -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <TextView
                            style="@style/TextAppearance.App.H3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/sa_ventas_titulo" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/sa_ficha_ventas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_periodo_reporte" />

                        <TextView
                            android:id="@+id/sa_ficha_ventas_vacio"
                            style="@style/TextAppearance.App.BodySecondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:text="@string/sa_ventas_vacio"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/sa_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_base"
            android:paddingEnd="@dimen/screen_margin"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/sa_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
