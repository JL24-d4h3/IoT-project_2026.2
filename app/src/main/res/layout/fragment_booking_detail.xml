<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <org.iot.project.ui.components.AppHeaderView
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/detalle_contenido"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_margin">

                    <org.iot.project.ui.components.BookingCardView
                        android:id="@+id/detalle_tarjeta"
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!-- Estadía -->
                    <TextView
                        style="@style/TextAppearance.App.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/detalle_estadia" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <TextView
                                android:id="@+id/detalle_habitacion"
                                style="@style/TextAppearance.App.H3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="Doble superior" />

                            <TextView
                                android:id="@+id/detalle_fechas"
                                style="@style/TextAppearance.App.BodySecondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                tools:text="12 oct – 15 oct · 3 noches" />

                            <TextView
                                android:id="@+id/detalle_huespedes"
                                style="@style/TextAppearance.App.BodySecondary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xs"
                                tools:text="2 huéspedes" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Cargos de la estadía -->
                    <LinearLayout
                        android:id="@+id/detalle_cargos_seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextAppearance.App.H2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:text="@string/detalle_cargos" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.App.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm">

                            <org.iot.project.ui.components.ChargeListView
                                android:id="@+id/detalle_cargos"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/space_md" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Pago -->
                    <TextView
                        style="@style/TextAppearance.App.H2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:text="@string/detalle_pago" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <org.iot.project.ui.components.PriceBreakdownView
                                android:id="@+id/detalle_desglose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:id="@+id/detalle_tarjeta_pago"
                                style="@style/TextAppearance.App.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_sm"
                                android:visibility="gone"
                                tools:text="Pagado con Visa ·4821"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Valoración ya dejada -->
                    <LinearLayout
                        android:id="@+id/detalle_valoracion_seccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <TextView
                            style="@style/TextAppearance.App.H2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_lg"
                            android:text="@string/detalle_tu_valoracion" />

                        <com.google.android.material.card.MaterialCardView
                            style="@style/Widget.App.Card"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="@dimen/space_md">

                                <org.iot.project.ui.components.RatingBadgeView
                                    android:id="@+id/detalle_valoracion_rating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content" />

                                <TextView
                                    android:id="@+id/detalle_valoracion_comentario"
                                    style="@style/TextAppearance.App.Body"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    tools:text="La vista desde la habitación es exactamente la de las fotos." />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Acciones: solo se pintan las que el estado permite -->
            <LinearLayout
                android:id="@+id/detalle_acciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/colorSurface"
                android:orientation="vertical"
                android:padding="@dimen/screen_margin">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accion_principal"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accion_secundaria"
                    style="@style/Widget.App.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/accion_cancelar"
                    style="@style/Widget.App.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/accion_cancelar_reserva"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/detalle_esqueleto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible">

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <org.iot.project.ui.components.LoadingSkeletonView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <org.iot.project.ui.components.ErrorStateView
            android:id="@+id/detalle_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
