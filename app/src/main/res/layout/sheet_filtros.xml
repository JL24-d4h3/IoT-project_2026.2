<?xml version="1.0" encoding="utf-8"?>
<!-- Filtros (§18). Hoja inferior con scroll: los servicios del catalogo son
     media docena de chips y en una pantalla de movil no caben junto al resto.

     Nada de lo que hay aqui se aplica hasta pulsar "Ver resultados": son
     controles que se prueban, y aplicar en cada toque lanzaria una busqueda
     por cada vez que el dedo se levanta. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/sheet_top_padding"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.App.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/resultados_filtros" />

            <ImageButton
                android:id="@+id/hoja_cerrar"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_cerrar"
                android:padding="@dimen/space_md"
                android:src="@drawable/ic_close"
                app:tint="@color/colorTextPrimary" />
        </LinearLayout>

        <!-- ============ Precio ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.App.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filtros_precio" />

                <TextView
                    android:id="@+id/precio_valor"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Hasta S/ 800" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/precio_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:contentDescription="@string/filtros_precio" />
        </LinearLayout>

        <!-- ============ Calificacion ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.App.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/filtros_rating" />

                <TextView
                    android:id="@+id/rating_valor"
                    style="@style/TextAppearance.App.BodySecondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="8 o más" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/rating_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:contentDescription="@string/filtros_rating" />
        </LinearLayout>

        <!-- ============ Tipo de habitacion ============ -->
        <TextView
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/filtros_habitacion" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_habitacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            app:singleSelection="true"
            app:selectionRequired="false" />

        <!-- ============ Servicios ============ -->
        <TextView
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/filtros_servicios" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_servicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xl"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hoja_limpiar"
                style="@style/Widget.App.Button.Text"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/filtros_limpiar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hoja_aplicar"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/filtros_aplicar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
