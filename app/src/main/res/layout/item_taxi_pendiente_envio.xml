<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <TextView
            style="@style/TextAppearance.App.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/taxi_api_pendiente_titulo" />

        <TextView
            android:id="@+id/pendiente_viaje"
            style="@style/TextAppearance.App.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/pendiente_estado"
            style="@style/TextAppearance.App.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pendiente_reintentar"
            style="@style/Widget.App.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/taxi_api_reintentar_solicitud" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
