<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja de un mensaje del hotel. Espejo de bg_bubble_own: la esquina recta
     es la inferior izquierda. Lleva borde porque el fondo es casi del color de
     la pantalla y sin el la burbuja se desdibujaria. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/colorSurface" />
    <stroke
        android:width="@dimen/border_width"
        android:color="@color/colorBorder" />
    <corners
        android:topLeftRadius="@dimen/radius_control"
        android:topRightRadius="@dimen/radius_control"
        android:bottomLeftRadius="@dimen/space_xs"
        android:bottomRightRadius="@dimen/radius_control" />
</shape>
